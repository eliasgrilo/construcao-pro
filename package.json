{
  "name": "construcao-pro",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:rollback-harness": "node packages/database/rpc-rollback-harness.mjs",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "pg": "^8.16.3",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@rollup/plugin-terser": "1.0.0",
    "lodash": "4.18.1",
    "serialize-javascript": "7.0.5"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.0.0"
  }
}
